name: Publish NuGet Package (Multi-Framework)

on:
  # 1. 手动触发：允许在 Actions 页面点击运行，并可自定义版本号
  workflow_dispatch:
    inputs:
      version:
        description: 'NuGet包版本号 (例如: 1.2.3)'
        required: true
        default: '1.0.0-manual'

  # 2. Release 触发：当你在 GitHub 上创建正式 Release 时自动运行
  release:
    types: [published]  # Release 发布时触发

# 全局环境变量
env:
  DOTNET_SKIP_FIRST_TIME_EXPERIENCE: true
  DOTNET_NOLOGO: true
  PACKAGE_OUTPUT_DIR: ./artifacts

jobs:
  build-and-publish:
    runs-on: ubuntu-latest
    permissions:
      contents: read      # 拉取代码
      packages: write     # 推送包到 GitHub Packages

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'  # 根据需要调整，支持多框架时推荐较新 SDK

      # 生成版本号（优先使用手动输入的版本，否则使用 Release Tag）
      - name: Set Version Number
        id: version
        run: |
          if [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
            VERSION="${{ github.event.inputs.version }}"
          elif [[ "${{ github.event_name }}" == "release" ]]; then
            VERSION="${GITHUB_REF#refs/tags/}"          else            # 备用（理论上不会走到这里，因为只有两种触发方式）            VERSION="1.0.0-unknown"          fi          echo "VERSION=$VERSION" >> $GITHUB_ENV          echo "Generated version: $VERSION"
      # 还原依赖（支持多框架）      - name: Restore dependencies        run: dotnet restore
      # 构建所有目标框架（会自动为每个框架编译）      - name: Build project        run: dotnet build --configuration Release --no-restore
      # 打包：会生成一个 .nupkg，里面包含所有目标框架的 DLL      - name: Pack NuGet package        run: |          dotnet pack --configuration Release \            --no-build \            --output ${{ env.PACKAGE_OUTPUT_DIR }} \            -p:PackageVersion=${{ env.VERSION }} \            -p:IncludeSymbols=true \            -p:SymbolPackageFormat=snupkg   # 可选：同时生成符号包，方便调试
      # 添加 GitHub Packages 源并进行认证（使用自动注入的 GITHUB_TOKEN）      - name: Add GitHub Packages source        run: |          dotnet nuget add source "https://nuget.pkg.github.com/${{ github.repository_owner }}/index.json" \            --name "github" \            --username "${{ github.repository_owner }}" \            --password "${{ secrets.GITHUB_TOKEN }}" \            --store-password-in-clear-text
      # 推送 .nupkg 和 .snupkg 到 GitHub Packages      - name: Push NuGet package        run: |          for file in ${{ env.PACKAGE_OUTPUT_DIR }}/*.nupkg; do            dotnet nuget push "$file" --source "github" --skip-duplicate          done